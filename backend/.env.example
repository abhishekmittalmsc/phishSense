# PhishSense Backend — Environment Variables
# Copy this file to .env and fill in your keys

# Server
PORT=8000

# VirusTotal API (get free key at https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=1939b9aa4732de3f8743ca554ba2e2e75d4d93bbc8133c058fb2ec333a27103

# AI Provider
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Other providers (swap AI_PROVIDER value to use these)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here

# AI_PROVIDER=mock  ← use this if you have no API keys yet

# ImagineTech provider
# AI_PROVIDER=imaginetech
# IMAGINETECH_API_URL=https://aide-sdlc-backend.imagine.tech/api/v1/brownfield/chat/completions
# IMAGINETECH_API_TOKEN=your_token_here
# IMAGINETECH_MODEL=giga-brain
